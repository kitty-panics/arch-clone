# Required Packages (Arch Linux):
# grub, grub-theme-vimix, mtools, dosfstools, mkinitcpio-archiso, squashfs-tools, xorriso, rsync, pv

version="3.0.0"

help_text="Usage: $0 [option]

Run with no options to create a bootable iso file for the
currently running Arch install.

Make sure to view and edit to your liking at least the 2
included config files:
 - settings.conf, which handles the basic config options/paths.
 - exclude.conf, which lists the files/folders excluded during creation of the iso.

valid options:
 -h, --help	show this help text
 -v, --version	display the version information"

while [[ $1 == -* ]]; do
	case "$1" in
		-h|--help)
			printf "$help_text"
			exit 0 ;;

		-v|--version)
			printf "$version\n"
			exit 0 ;;

		*)
			printf "\t invalid option: $1 \n\n"
			printf "\t Try: $0 -h for full help. \n\n"
			exit 1 ;;
	esac
done

# Check that user is root.
[[ $(id -u) -eq 0 ]] || { echo -e "\n\t You need to be root!\n" ; exit 1 ; }

current_directory=$(pwd)
cat "$current_directory"/exclude/*.conf > "$current_directory"/exclude.conf

configfile="$current_directory/settings.conf"
rsync_excludes="$current_directory/exclude.conf"
grub_template="$current_directory/grub.cfg"

[[ -e "$configfile" ]] || { echo "Configuration file, $configfile is missing." ; exit 1 ; }
source "$configfile"

echo -e "> Config file: $configfile"
echo -e "> Excludes file: $rsync_excludes"
echo -e "> GRUB template file: $grub_template"

# DISTRO comes from settings.conf (distro_name). Fall back to "Arch" if unset or empty.
if [[ -z "$distro_name" ]]; then
	DISTRO="Arch"
else
	DISTRO="$distro_name"
fi
# Default ISO label, GRUB uses it to find the ISO
[[ -n "$volid" ]] || volid="archlive"

# Record errors in a logfile.
exec 2>"$error_log"

case "${DEBUG,,}" in
	yes|true|1|on) set -x ;;
esac

check_directories() {
	# Check that fs_dir, work_dir, iso_dir exists
	for dir in "$fs_dir" "$work_dir" "$iso_dir"; do
		if [[ ! -d "$dir" ]]; then
			mkdir -p "$dir" && chmod 755 "$dir" || { echo "无法创建 $dir" >&2; exit 1; }
		fi
	done

	mkdir -p \
		  "$work_dir/iso/arch/boot/x86_64" \
		  "$work_dir/iso/arch/x86_64" \
		  "$work_dir/iso/boot/grub/themes"
}

rebuild_initrd() {
	if [[ ! -f /etc/mkinitcpio.conf ]]; then
		echo "Error: /etc/mkinitcpio.conf is missing"
		exit 1
	fi

	mkinitcpio_modules=$(sed -n 's/^MODULES=(\([^)]*\)).*$/\1/p' /etc/mkinitcpio.conf)
	mkinitcpio_hooks=$(sed -n 's/^HOOKS=(\([^)]*\)).*$/\1/p' /etc/mkinitcpio.conf)

	if [[ -z "$mkinitcpio_hooks" ]]; then
		echo "Error: HOOKS in mkinitcpio is empty"
		exit 1
	fi

	new_hooks=$(echo "$mkinitcpio_hooks" | sed 's/ block/ archiso archiso_loop_mnt block/')
	[[ "$new_hooks" != "$mkinitcpio_hooks" ]] || { echo "Error: 'block' not found in HOOKS" >&2; exit 1; }
	cat > "${work_dir}/mkinitcpio.conf" <<EOF
MODULES=(loop dm-snapshot isofs squashfs $mkinitcpio_modules)
HOOKS=($new_hooks)
COMPRESSION="zstd"
COMPRESSION_OPTIONS=(-T0 -15)
EOF

	mkinitcpio -c "${work_dir}"/mkinitcpio.conf \
			   -g "${work_dir}"/iso/arch/boot/x86_64/"${initrd_image##*/}"
}

copy_kernelinitrd() {
	[[ -f "$kernel_image" ]] || { echo "kernel_image missing: $kernel_image" >&2; exit 1; }
	cp "$kernel_image" "$work_dir"/iso/arch/boot/x86_64/
}

copy_filesystem() {
	rsync -aAXH --numeric-ids --info=PROGRESS2 --human-readable --delete --delete-excluded \
		  --filter="merge $rsync_excludes" / "$fs_dir"/
}

edit_system() {
	# /etc/fstab should exist, even if it's empty,
	# to prevent error messages at boot
	mv "$fs_dir"/etc/fstab "$fs_dir"/etc/fstab.bak
	touch "$fs_dir"/etc/fstab

	# Blank out systemd machine id. If it does not exist, systemd-journald
	# will fail, but if it exists and is empty, systemd will automatically
	# set up a new unique ID.
	: > "$fs_dir"/etc/machine-id

	# add some basic files to /dev
	mknod -m 622 "$fs_dir"/dev/console c 5 1
	mknod -m 666 "$fs_dir"/dev/null c 1 3
	mknod -m 666 "$fs_dir"/dev/zero c 1 5
	mknod -m 666 "$fs_dir"/dev/ptmx c 5 2
	mknod -m 666 "$fs_dir"/dev/tty c 5 0
	mknod -m 444 "$fs_dir"/dev/random c 1 8
	mknod -m 444 "$fs_dir"/dev/urandom c 1 9
	chown -v root:tty "$fs_dir"/dev/{console,ptmx,tty}

	ln -sv /proc/self/fd "$fs_dir"/dev/fd
	ln -sv /proc/self/fd/0 "$fs_dir"/dev/stdin
	ln -sv /proc/self/fd/1 "$fs_dir"/dev/stdout
	ln -sv /proc/self/fd/2 "$fs_dir"/dev/stderr
	ln -sv /proc/kcore "$fs_dir"/dev/core
	mkdir -v "$fs_dir"/dev/shm
	mkdir -v "$fs_dir"/dev/pts
	chmod 1777 "$fs_dir"/dev/shm
}

get_filename() {
	#snapshot_datetime=$(date +%Y%m%d)
	#filename="$iso_basename"-"$snapshot_datetime".iso
	snapshot_datetime=$(date +%Y)
	filename="$iso_basename"_v"$snapshot_datetime".iso
}

prepare_grub_files() {
	# Copy GRUB template, fonts, themes
	cp "$grub_template" "$work_dir"/iso/boot/grub/grub.cfg
	#cp /usr/share/grub/unicode.pf2 "$work_dir"/iso/boot/grub/fonts/
	cp -r /usr/share/grub/themes/"$grub_theme" "$work_dir"/iso/boot/grub/themes/
}

set_boot_options() {
	# Modify the theme.
	sed -i "s:\${grub_theme}:$grub_theme:g" "$work_dir"/iso/boot/grub/grub.cfg
	# Modify the boot menu.
	sed -i "s:\${DISTRO}:$DISTRO:g" "$work_dir"/iso/boot/grub/grub.cfg
	sed -i "s:\${kernel_image}:${kernel_image##*/}:g" "$work_dir"/iso/boot/grub/grub.cfg
	sed -i "s:\${initrd_image}:${initrd_image##*/}:g" "$work_dir"/iso/boot/grub/grub.cfg
	sed -i "s:\${volid}:$volid:g" "$work_dir"/iso/boot/grub/grub.cfg
}

squash_filesystem() {
	echo "Squashing the filesystem..."
	mksquashfs "$fs_dir"/ $work_dir/iso/arch/x86_64/airootfs.sfs ${mksq_comp} -noappend -b 1M -no-fragments \
	|| { echo -e "\n Error: mksquashfs failed. Exiting..." ; exit 1 ; }
}

make_iso_fs() {
	echo "Creating ISO: $iso_dir/$filename"
	grub-mkrescue --themes="" --locales="" --fonts="" \
				-V "$volid" -o "$iso_dir"/"$filename" "$work_dir"/iso/ \
	|| { echo -e "\n Error: grub-mkrescue failed. Exiting..." ; exit 1 ; }
	sync
	echo "ISO created, finished..."
}

cleanup() {
	echo "Cleaning..."
	#rm -rf "$fs_dir"
	#rm -rf "$work_dir"
	rm "$current_directory"/exclude.conf
}

echo -e "\n*\n* This may take a moment while the program checks for free space.\n*"
check_directories
copy_kernelinitrd
copy_filesystem
rebuild_initrd
edit_system
get_filename
prepare_grub_files
set_boot_options
squash_filesystem
make_iso_fs
cleanup
echo -e "\n\tAll finished!\n"
exit 0
